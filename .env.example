# DEV is the default. Missing configuration shows a locked setup screen.
# Explicit demo mode is only for local regression tests, never a login fallback.
NEXT_PUBLIC_APP_MODE=supabase-dev
# Copy only the existing project's URL and sb_publishable_ key from Supabase.
# Never put a secret/service_role key, database password or access token here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
